ANTHROPIC_API_KEY=sk-ant-...
JWT_SECRET=replace-with-a-long-random-string
PORT=3000

# Paid tier (Agent Dispatch). Dispatch is refused until a verified subscription exists.
# Comma-separated App Store product ids; empty = nobody can subscribe (fails closed).
SUBSCRIPTION_PRODUCT_IDS=
APP_BUNDLE_ID=com.judy98122.gtdapp
# App Review/TestFlight buy in Sandbox. Set to "Production" only after review passes.
APPLE_ENVIRONMENTS=Production,Sandbox

# Dispatch cost limits (all optional; these are the defaults)
DISPATCH_MONTHLY_QUOTA=30        # runs per subscriber per month (a refund is given when a run fails or only asks a question)
DISPATCH_MAX_CONTINUATIONS=6     # rounds of the agent's tool loop per run
DISPATCH_TIMEOUT_MS=170000       # whole run; the app stops waiting at 180s
DISPATCH_MAX_SEARCHES=8          # web searches per round
